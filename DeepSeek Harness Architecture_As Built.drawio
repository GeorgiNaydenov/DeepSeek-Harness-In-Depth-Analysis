    <object label="&lt;b&gt;Native addon&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#5f6b7a&quot;&gt;Landlock launcher and file locks&lt;/span&gt;" id="w6.leaf.35" cite="C264" comp="pl_native" state="on">
     <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f2933;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=42;spacingRight=6;spacingTop=8;spacingBottom=2;" vertex="1" parent="1">
