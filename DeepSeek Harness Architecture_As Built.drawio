    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w4.leaf.45" value="&lt;i&gt;The sandbox confines what commands may write. Each call reports whether enforcement was full or partial.&lt;/i&gt;">
     <mxGeometry x="1600" y="100" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w4.leaf.46" value="&lt;i&gt;Full access skips the sandbox, and the approval policy then becomes never.&lt;/i&gt;">
     <mxGeometry x="1600" y="177" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w4.leaf.47" value="&lt;i&gt;An unanswered approval defaults to unavailable, which denies the call.&lt;/i&gt;">
     <mxGeometry x="1600" y="254" width="296" height="52" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w4.leaf.48" value="&lt;i&gt;Every approval is written to the session log as an asked and decided pair.&lt;/i&gt;">
     <mxGeometry x="1600" y="316" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w4.leaf.49" value="&lt;i&gt;Official DeepSeek requests carry a session log suffix by default, and telemetry is sent only after feedback.&lt;/i&gt;">
