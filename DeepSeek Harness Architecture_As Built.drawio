     </mxCell>
    </object>
    <mxCell style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1" id="w6.icon.17" value="">
     <mxGeometry x="979.18" y="936" width="26" height="26" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.36" value="&lt;i&gt;Every supported Node application launches through a named dsh profile.&lt;/i&gt;">
     <mxGeometry x="1600" y="100" width="296" height="52" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.37" value="&lt;i&gt;Desktop runs the same web stack in its own host process, with its own reserved profile.&lt;/i&gt;">
     <mxGeometry x="1600" y="162" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.38" value="&lt;i&gt;File and subprocess providers share one execution world, so a remote provider moves shells, terminals and language servers together.&lt;/i&gt;">
     <mxGeometry x="1600" y="239" width="296" height="82" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.39" value="&lt;i&gt;The SDK and ACP profiles run the same dsh program and talk over stdio.&lt;/i&gt;">
     <mxGeometry x="1600" y="331" width="296" height="52" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.40" value="&lt;i&gt;A platform chain is probed in preference order only when it has more than one candidate. Linux tries bubblewrap before the Landlock launcher, macOS and Windows have a sole candidate each.&lt;/i&gt;">
     <mxGeometry x="1600" y="393" width="296" height="112" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w6.leaf.41" value="&lt;i&gt;When no backend on the host is usable, a confined mode fails closed instead of running the command unconfined.&lt;/i&gt;">
     <mxGeometry x="1600" y="515" width="296" height="82" as="geometry" />
    </mxCell>
