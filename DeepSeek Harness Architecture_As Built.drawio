    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.4" value="&lt;i&gt;Every cell is read from the bundle patch files, composed in profile order.&lt;/i&gt;">
     <mxGeometry x="1600" y="100" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.5" value="&lt;i&gt;In web and desktop, tools live in the agent presets, so those host rows read Per preset.&lt;/i&gt;">
     <mxGeometry x="1600" y="177" width="296" height="67" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.6" value="&lt;i&gt;SDK minimal is one standalone bundle, and it pins full access.&lt;/i&gt;">
     <mxGeometry x="1600" y="254" width="296" height="52" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.7" value="&lt;i&gt;Desktop reuses the web bundles under its own profile name.&lt;/i&gt;">
     <mxGeometry x="1600" y="316" width="296" height="52" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.8" value="&lt;i&gt;The lower table shows the four web agent presets. Platform gated means bash or PowerShell by operating system.&lt;/i&gt;">
     <mxGeometry x="1600" y="378" width="296" height="82" as="geometry" />
    </mxCell>
    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="w9.leaf.9" value="&lt;i&gt;The shell tool runs through bash sandbox, which tries bubblewrap first, then Landlock on Linux.&lt;/i&gt;">
     <mxGeometry x="1600" y="470" width="296" height="67" as="geometry" />
    </mxCell>
