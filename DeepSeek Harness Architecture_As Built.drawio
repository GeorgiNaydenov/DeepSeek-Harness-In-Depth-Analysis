    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#f5f5f5;strokeColor=#c7cdd6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f2933;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1" id="s1.leaf.5" value="&lt;i&gt;Rows come from the seam table in the repo docs. Mounted means a shipped profile or web preset loads it.&lt;/i&gt;">
