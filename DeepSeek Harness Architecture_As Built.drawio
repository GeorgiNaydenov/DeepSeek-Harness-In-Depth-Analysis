    </mxCell>
    <mxCell style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=13;fontColor=#5f6b7a;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingLeft=0;spacingRight=0;fontStyle=0;" vertex="1" parent="1" id="e0.text.3" value="&lt;i&gt;The web server binds to your own machine, and every request speaks for one operator.&lt;/i&gt;">
